# Supreme Suite — environment (all optional for the local trial sandbox)
# The trial experience runs 100% client-side (localStorage), so none of these
# are required to demo. They are the wiring points for going to production.

# --- Supabase (production tenant data; swap the localStorage repo for this) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (transactional + booking notification email) ---
RESEND_API_KEY=
SUITE_FROM_EMAIL=hello@jsupremetech.online

# --- Branding / platform ---
NEXT_PUBLIC_PLATFORM_NAME=Supreme Suite
NEXT_PUBLIC_PLATFORM_OWNER=J Supreme Tech
NEXT_PUBLIC_TRIAL_DAYS=3
