# Supreme Suite — environment variables
# The trial experience runs 100% client-side (localStorage) — no vars needed to demo.
# Set these to enable: paid-tenant auth, cloud data persistence, and email.

# ── Supabase (project ciggiwpztuxkmbaccrlp) ───────────────────────────────
# ss_tenants + ss_purchases tables live here.
NEXT_PUBLIC_SUPABASE_URL=https://ciggiwpztuxkmbaccrlp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign session cookies for paid tenant logins.
# Use a long random string (64+ chars). MUST match on all deployments.
SS_JWT_SECRET=change-me-to-a-long-random-string-64-chars-min

# ── Resend (booking notifications from the workspace) ─────────────────────
RESEND_API_KEY=re_your_resend_key
SUITE_FROM_EMAIL=hello@jsupremetech.online

# ── Branding / platform ───────────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_NAME=Supreme Suite
NEXT_PUBLIC_PLATFORM_OWNER=J Supreme Tech
NEXT_PUBLIC_TRIAL_DAYS=3
